,{className:"mt-1 font-mono text-[11px] leading-[1.5] text-white/70",children:"Interaction > image. Territory coupling via Δφ ∝ vᵢ·vⱼ preserves c. Blind bypasses mirror. Immortal jellyfish proves life does not need centralized map-maker. Gut feels ground."})]})]}),c("div",{className:"mt-4 flex flex-wrap gap-2 font-mono text-[10px]",children:[u("span",{className:"rounded-full bg-[#00f0ff]/15 px-2 py-0.5 text-[#00f0ff]",children:"Ernsberger 2018"}),u("span",{className:"rounded-full bg-[#00f0ff]/15 px-2 py-0.5 text-[#00f0ff]",children:"Furness 2012"}),u("span",{className:"rounded-full bg-[#00f0ff]/15 px-2 py-0.5 text-[#00f0ff]",children:"Breit 2018"}),u("span",{className:"rounded-full bg-[#ffd700]/15 px-2 py-0.5 text-[#ffd700]",children:"Godfrey-Smith 2016"}),u("span",{className:"rounded-full bg-[#a78bfa]/15 px-2 py-0.5 text-[#a78bfa]",children:"Saccone 2024"}),u("span",{className:"rounded-full bg-white/10 px-2 py-0.5 text-white/50",children:"Bedny 2016"})]})]})}),c("div",{className:"md:col-span-12 mt-4 rounded-[16px] border border-white/[0.06] bg-[#0f0f18] p-6 md:p-8",children:[c("div",{className:"flex items-center gap-3",children:[u("div",{className:"h-2 w-2 rounded-full bg-[#00f0ff] animate-pulse"}),u("div",{className:"font-mono text-[11px] tracking-[0.2em] text-white/40",children:"REFERENCES TABLE"}),u("div",{className:"h-px flex-1 bg-white/10"})]}),u("div",{className:"mt-6 overflow-x-auto",children:c("table",{className:"w-full min-w-[900px] border-collapse font-mono text-[11px]",children:[u("thead",{children:c("tr",{className:"border-b border-white/[0.06] text-left text-[10px] tracking-[0.12em] text-white/30",children:[u("th",{className:"px-4 py-2 font-normal",children:"CITATION"}),u("th",{className:"px-4 py-2 font-normal",children:"CLAIM"}),u("th",{className:"px-4 py-2 font-normal",children:"FUNNEL"}),u("th",{className:"px-4 py-2 font-normal",children:"ROLE"})]})}),u("tbody",{className:"divide-y divide-white/[0.04]",children:[["Hines 2026","CTCF TAD median ~800kb