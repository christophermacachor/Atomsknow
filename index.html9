.transition{
  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}
:root {
  --bg: #050508;
  --bg-soft: #0c0c14;
  --surface: #11111b;
  --surface-2: #181822;
  --text: #e8e8ec;
  --text-dim: #a0a0b0;
  --text-faint: #5c5c6a;
  --cyan: #00f0ff;
  --gold: #ffd700;
  --border: rgba(255,255,255,0.08);
  --border-strong: rgba(255,255,255,0.14);
  --font-serif: "Fraunces", Georgia, serif;
  --font-sans: "Inter", system-ui, sans-serif;
  --font-mono: "JetBrains Mono", monospace;
}
* {
  font-variant-ligatures: common-ligatures;
}
html {
  scroll-behavior: smooth;
}
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  overscroll-behavior: none;
}
::-moz-selection {
  background: var(--cyan);
  color: #000;
}
::selection {
  background: var(--cyan);
  color: #000;
}
/* polyhedral grid pattern */
.poly-grid {
  background-image: 
    linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px),
    linear-gradient(60deg, rgba(0,240,255,0.03) 1px, transparent 1px);
  background-size: 48px 48px, 48px 48px, 84px 84px;
}
/* custom scroll */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.12);
  border-radius: 10px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
.hover\:bg-\[\#00f0ff\]\/20:hover{
  background-color: rgb(0 240 255 / 0.2);
}
.hover\:bg-\[\#ffd700\]\/20:hover{
  background-color: rgb(255 215 0 / 0.2);
}
.hover\:bg-white\/\[0\.02\]:hover{
  background-color: rgb(255 255 255 / 0.02);
}
.hover\:bg-white\/\[0\.06\]:hover{
  background-color: rgb(255 255 255 / 0.06);
}
.hover\:bg-white\/\[0\.12\]:hover{
  background-color: rgb(255 255 255 / 0.12);
}
.hover\:text-white:hover{
  --tw-text-opacity: 1;
  color: rgb(255 255 255 / var(--tw-text-opacity, 1));
}
.hover\:decoration-\[\#00f0ff\]:hover{
  text-decoration-color: #00f0ff;
}
.hover\:decoration-\[\#ffd700\]:hover{
  text-decoration-color: #ffd700;
}
@media (min-width: 768px){
  .md\:-left-10{
    left: -2.5rem;
  }
  .md\:col-span-12{
    grid-column: span 12 / span 12;
  }
  .md\:col-span-6{
    grid-column: span 6 / span 6;
  }
  .md\:block{
    display: block;
  }
  .md\:inline-block{
    display: inline-block;
  }
  .md\:flex{
    display: flex;
  }
  .md\:hidden{
    display: none;
  }
  .md\:grid-cols-12{
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }
  .md\:grid-cols-2{
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .md\:grid-cols-3{
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .md\:grid-cols-4{
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .md\:grid-cols-\[1\.1fr_0\.9fr\]{
    grid-template-columns: 1.1fr 0.9fr;
  }
  .md\:grid-cols-\[1\.2fr_0\.8fr\]{
    grid-template-columns: 1.2fr 0.8fr;
  }
  .md\:p-10{
    padding: 2.5rem;
  }
  .md\:p-8{
    padding: 2rem;
  }
  .md\:px-10{
    padding-left: 2.5rem;
    padding-right: 2.5rem;
  }
  .md\:px-5{
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }
  .md\:px-8{
    padding-left: 2rem;
    padding-right: 2rem;
  }
  .md\:py-10{
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .md\:py-14{
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }
  .md\:py-6{
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .md\:pt-12{
    padding-top: 3rem;
  }
  .md\:pt-14{
    padding-top: 3.5rem;
  }
  .md\:pt-24{
    padding-top: 6rem;
  }
  .md\:text-\[13px\]{
    font-size: 13px;
  }
  .md\:text-\[20px\]{
    font-size: 20px;
  }
  .md\:text-\[22px\]{
    font-size: 22px;
  }
  .md\:text-\[24px\]{
    font-size: 24px;
  }
  .md\:text-\[30px\]{
    font-size: 30px;
  }
  .md\:text-\[32px\]{
    font-size: 32px;
  }
  .md\:text-\[36px\]{
    font-size: 36px;
  }
  .md\:text-\[38px\]{
    font-size: 38px;
  }
  .md\:text-\[56px\]{
    font-size: 56px;
  }
}
</style>
</head>
